[Unit]
Description=Overseer approved system-unit executor
After=overseer-admin-executor.socket

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/overseer-executor
Environment=PYTHONPATH=@OVERSEER_RELEASE@/app/src:@OVERSEER_RELEASE@/site-packages
Environment=PYTHONHOME=@OVERSEER_RELEASE@/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@OVERSEER_PYTHON@ -m overseer.admin_executor serve-one --allowlist-file /etc/overseer/admin-executor-allowlist.json --public-key-file /etc/overseer/admin-executor-public-key --ledger /var/lib/overseer-executor/ledger.sqlite3
StandardInput=socket
StandardOutput=socket
RuntimeMaxSec=30s
TimeoutStopSec=5s
StateDirectory=overseer-executor
StateDirectoryMode=0700
ReadOnlyPaths=@OVERSEER_RELEASE@
ReadOnlyPaths=/etc/overseer
ReadWritePaths=/var/lib/overseer-executor
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
