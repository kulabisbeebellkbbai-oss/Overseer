[Unit]
Description=Overseer disposable dedicated-principal API canary
Wants=overseer-codex-user-bridge.socket
After=local-fs.target overseer-codex-user-bridge.socket

[Service]
Type=simple
User=overseer
Group=overseer
WorkingDirectory=@OVERSEER_RELEASE@
Environment=PYTHONPATH=@OVERSEER_RELEASE@/app/src:@OVERSEER_RELEASE@/site-packages
Environment=PYTHONHOME=@OVERSEER_RELEASE@/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OVERSEER_DEDICATED_PRINCIPAL=1
Environment=OVERSEER_ADMIN_TICKET_PRIVATE_KEY=/etc/overseer/admin-ticket-private-key
Environment=OVERSEER_ADMIN_EXECUTOR_SOCKET=/run/overseer/admin-executor.sock
Environment=OVERSEER_USER_BRIDGE_SOCKET=/run/overseer/codex-user-bridge.sock
Environment=OVERSEER_USER_BRIDGE_SERVER_UID=@GOD_UID@
Environment=OVERSEER_PSYCHLO_ENDPOINT=http://127.0.0.1:8798
Environment=OVERSEER_PSYCHLO_BRIDGE_DATABASE=/var/lib/overseer/psychlo-canary-bridge.sqlite3
Environment=OVERSEER_PSYCHLO_PROJECT_BINDINGS_FILE=/etc/overseer/psychlo-project-bindings.json
Environment=OVERSEER_PSYCHLO_PEER_SECRET_FILE=%d/psychlo-peer-secret
Environment=OVERSEER_ROADEX_PROJECT_HUMAN_THREAD_DATABASE=/var/lib/overseer/roadex-canary-relay.sqlite3
Environment=OVERSEER_ROADEX_PROJECT_HUMAN_THREAD_SECRET_FILE=%d/roadex-peer-secret
Environment=OVERSEER_ROADEX_PROJECT_HUMAN_THREAD_QUESTION_ENDPOINT=http://127.0.0.1:8780
LoadCredential=api-token:/etc/overseer/api-token
LoadCredential=psychlo-peer-secret:/etc/overseer/psychlo-peer-secret
LoadCredential=roadex-peer-secret:/etc/overseer/roadex-project-human-thread-secret
ExecStart=@OVERSEER_PYTHON@ -m overseer.cli serve-api --store /var/lib/overseer/overseer-canary.sqlite3 --host 127.0.0.1 --port 18766 --auth-token-file %d/api-token --admin-approval-verifier-file /etc/overseer/admin-approval-verifier.json --roadex-fixture-approval-verifier-file /etc/overseer/roadex-fixture-approval-verifier.json
RuntimeMaxSec=10min
TimeoutStopSec=10s
StateDirectory=overseer
StateDirectoryMode=0700
ReadOnlyPaths=@OVERSEER_RELEASE@
ReadOnlyPaths=/etc/overseer
ReadWritePaths=/var/lib/overseer
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
