[Unit]
Description=Overseer read-only Codex user bridge
Requires=overseer-codex-user-bridge.socket
After=overseer-codex-user-bridge.socket

[Service]
Type=simple
User=god
Group=god
WorkingDirectory=@OVERSEER_RELEASE@
Environment=PYTHONPATH=@OVERSEER_RELEASE@/app/src:@OVERSEER_RELEASE@/site-packages
Environment=PYTHONHOME=@OVERSEER_RELEASE@/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OVERSEER_BRIDGE_PEER_UID=@OVERSEER_UID@
ExecStart=@OVERSEER_PYTHON@ -m overseer.user_bridge serve --socket-fd=3 --peer-uid=@OVERSEER_UID@
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/god/.codex/codex-projects.csv
BindReadOnlyPaths=/home/god/.local/share/overseer/codex-usage-mcp
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=@OVERSEER_RELEASE@
UMask=0077

[Install]
WantedBy=multi-user.target
