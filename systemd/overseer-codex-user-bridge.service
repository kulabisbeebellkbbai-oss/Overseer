[Unit]
Description=Overseer read-only Codex user bridge
Requires=overseer-codex-user-bridge.socket
After=overseer-codex-user-bridge.socket

[Service]
Type=simple
User=@GOD_UID@
Group=@GOD_GID@
WorkingDirectory=@OVERSEER_RELEASE@
Environment=PYTHONPATH=@OVERSEER_RELEASE@/app/src:@OVERSEER_RELEASE@/site-packages
Environment=PYTHONHOME=@OVERSEER_RELEASE@/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONSAFEPATH=1
Environment=LD_LIBRARY_PATH=@OVERSEER_RELEASE@/lib
Environment=OVERSEER_BRIDGE_PEER_UID=@OVERSEER_UID@
Environment=HOME=/home/god
Environment=XDG_RUNTIME_DIR=/run/user/@GOD_UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@GOD_UID@/bus
ExecStart=@OVERSEER_PYTHON@ -s -P -m overseer.user_bridge serve --socket-fd=3 --peer-uid=@OVERSEER_UID@
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/god/.codex/codex-projects.csv
BindReadOnlyPaths=/home/god/.local/share/overseer/codex-usage-mcp
BindReadOnlyPaths="/home/god/Documents/Codex Workspace/Overseer"
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=@OVERSEER_RELEASE@
UMask=0077

[Install]
WantedBy=multi-user.target
