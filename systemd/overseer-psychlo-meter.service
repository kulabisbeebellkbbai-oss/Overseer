[Unit]
Description=Produce one authority-signed Codex provider percentage observation for Psychlo
After=overseer-codex-usage-mcp.service
# Deliberately absent until the narrow Codex authentication boundary is approved.
ConditionPathExists=%h/.config/overseer/psychlo-meter/producer-enabled

[Service]
Type=oneshot
Environment=PYTHONPATH=%h/.local/share/overseer/project/src
Environment=OVERSEER_CODEX_USAGE_SOURCE=codex-app-server
ExecStart=%h/.local/share/overseer/venvs/psychlo-v1-1-cryptography-46.0.7-86d2f47/bin/python -m overseer.psychlo_usage_meter_cli --authority %h/.config/overseer/psychlo-usage-authority.json --meter-config %h/.config/overseer/psychlo-meter/config.json --private-key %d/psychlo-usage-authority-private-key --output %h/.local/share/overseer/psychlo-meter/latest-observation.json
LoadCredential=psychlo-usage-authority-private-key:%h/.config/overseer/psychlo-usage-authority-private-key.pem
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.config/overseer/psychlo-meter/producer-enabled
BindReadOnlyPaths=%h/.config/overseer/psychlo-usage-authority.json
BindReadOnlyPaths=%h/.config/overseer/psychlo-meter/config.json
BindReadOnlyPaths=%h/.local/share/overseer/project/src
BindPaths=%h/.local/share/overseer/psychlo-meter
UMask=0077
