[Unit]
Description=Run one Quark usage-aware Codex work cycle
After=overseer-codex-usage-mcp.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/overseer/runtime.env
WorkingDirectory=@OVERSEER_INSTALL@
ExecStart=/usr/bin/env -- ${OVERSEER_PYTHON} -m overseer.quark_scheduler_cli --db @OVERSEER_QUARK_DB@ run-cycle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
