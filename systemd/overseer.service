[Unit]
Description=Overseer v1.1 autonomous operations runtime
After=default.target

[Service]
Type=simple
WorkingDirectory=@OVERSEER_INSTALL@
EnvironmentFile=%h/.config/overseer/runtime.env
ExecStartPre=/usr/bin/test -d ${OVERSEER_INSTALL}/src
ExecStart=/usr/bin/env -- ${OVERSEER_PYTHON} -m overseer.cli run --store ${OVERSEER_STORE}
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
