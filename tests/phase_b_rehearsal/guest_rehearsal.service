[Unit]
Description=Disposable Overseer Phase B guest rehearsal
After=local-fs.target
ConditionPathIsDirectory=/mnt/overseer-source
ConditionPathIsDirectory=/opt/overseer-phase-b-rehearsal
ConditionPathExists=/etc/overseer-phase-b-rehearsal/source-commit

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/overseer-phase-b-rehearsal
Environment=OVERSEER_PHASE_B_GUEST=1
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=source-commit:/etc/overseer-phase-b-rehearsal/source-commit
ExecStart=/usr/bin/python3 -s -P /opt/overseer-phase-b-rehearsal/guest_rehearsal.py
StandardOutput=journal+console
StandardError=journal
TimeoutStartSec=15min
TimeoutStopSec=10s
NoNewPrivileges=no
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/mnt/overseer-source
ReadOnlyPaths=/etc/overseer-phase-b-rehearsal/source-commit
ReadWritePaths=/etc/overseer-phase-b-rehearsal
ReadWritePaths=/run/overseer /run/overseer-canary
ReadWritePaths=/var/lib/overseer-canary /var/lib/overseer-executor /var/lib/overseer-phase-b-rehearsal
ReadWritePaths=/opt/overseer-phase-b-rehearsal
ReadWritePaths=/etc/systemd/system/overseer-approval-smoke.service
ReadWritePaths=/etc/systemd/system/overseer-api-canary.service
ReadWritePaths=/etc/systemd/system/overseer-admin-executor.socket
ReadWritePaths=/etc/systemd/system/overseer-admin-executor@.service
ReadWritePaths=/etc/systemd/system/overseer-codex-user-bridge.socket
ReadWritePaths=/etc/systemd/system/overseer-codex-user-bridge.service
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
UMask=0077

[Install]
WantedBy=multi-user.target
